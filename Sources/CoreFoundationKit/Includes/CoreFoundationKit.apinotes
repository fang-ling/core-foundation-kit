---
Name: CoreFoundationKit
Tags:
  - Name: _CoreFoundationArray
    SwiftImportAs: reference
    SwiftRetainOp: _CoreFoundationArrayRetain
    SwiftReleaseOp: _CoreFoundationArrayRelease
  - Name: _CoreFoundationString
    SwiftImportAs: reference
    SwiftRetainOp: _CoreFoundationStringRetain
    SwiftReleaseOp: _CoreFoundationStringRelease
Functions:
  - Name: CoreFoundationArrayInitialize
    SwiftName: _CoreFoundationArray.init(objects:count:)
    SwiftReturnOwnership: retained
  - Name: CoreFoundationArrayCopy
    SwiftName: _CoreFoundationArray.copy(self:)
    SwiftReturnOwnership: retained
  - Name: CoreFoundationArrayGetCount
    SwiftName: getter:_CoreFoundationArray.count(self:)
  - Name: CoreFoundationArrayGetObjectAtIndex
    SwiftName: _CoreFoundationArray.object(self:at:)
  - Name: CoreFoundationArraySetObjectAtIndex
    SwiftName: _CoreFoundationArray.setObject(self:_:at:)
  - Name: CoreFoundationArrayReplaceSubrangeWithObjects
    SwiftName: _CoreFoundationArray.replaceSubrange(self:_:with:_:)
  - Name: CoreFoundationRangeMake
    Availability: nonswift
    AvailabilityMsg: 'Use CoreFoundationRange.init(location:count:) instead.'
  - Name: CoreFoundationStringInitializeWithUTF8CString
    SwiftName: _CoreFoundationString.init(cString:)
    SwiftReturnOwnership: retained
  - Name: CoreFoundationStringGetCount
    SwiftName: getter:_CoreFoundationString.count(self:)
